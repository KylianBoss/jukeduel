# Ton app Spotify : https://developer.spotify.com/dashboard → ton app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Doit être déclarée à l'identique dans le dashboard Spotify (Redirect URIs).
# En ligne : https://ton-domaine/callback · en local : http://127.0.0.1:8080/callback
SPOTIFY_REDIRECT_URI=https://jukeduel.example.com/callback

# Mot de passe de l'hôte pour /admin (12 caractères ou plus)
ADMIN_PASSWORD=

# Optionnel
# PORT=8080
# DATA_DIR=./data
